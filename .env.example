PORT=3000
ADMIN_TOKEN=replace-with-a-long-random-admin-token
GHOST_T_ADMIN_TOKEN=replace-with-a-long-random-ghost-t-admin-token
DP_ADMIN_TOKEN=replace-with-a-long-random-dp-admin-token
DISCORD_BOT_API_TOKEN=replace-with-a-long-random-discord-bot-token
PAYMENT_PROVIDER=manual
PURCHASE_ORDER_SECRET=replace-with-a-long-random-purchase-order-secret
ELDORADO_API_KEY=
DEVICE_HASH_SECRET=replace-with-a-long-random-device-secret
CORS_ORIGIN=*
PUBLIC_BASE_URL=http://localhost:3000
DEFAULT_SCRIPT_URL=
GHOST_T_SCRIPT_URL=
DP_SCRIPT_URL=
SCRIPT_URL_ALLOWLIST=
ALLOW_INSECURE_SCRIPT_URLS=false
MAX_SCRIPT_BYTES=5242880
AUTO_DELETE_EXPIRED_KEYS=true
DATABASE_URL=
PGSSLMODE=require

# Signed validate-key responses. Must differ from DEVICE_HASH_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leaving this blank makes responses UNSIGNED (server warns, clients still work).
KEY_RESPONSE_SIGNING_SECRET=replace-with-a-different-long-random-secret

# Set to 1 only AFTER every deployed client verifies signatures. With no signing secret and
# strict mode on, validation fails with HTTP 500 instead of silently returning unsigned data.
KEY_SIG_STRICT=0

# Burner cleanup: delete non-lifetime keys that have not been executed for this many days.
# Lifetime keys (expires_after_hours IS NULL) are never removed. Paused keys are kept.
BURNER_INACTIVE_DAYS=3
AUTO_DELETE_STALE_BURNERS=true
# Minimum gap between sweeps, in ms. The sweep runs in the request path, so no cron is needed.
STALE_SWEEP_INTERVAL_MS=1800000
